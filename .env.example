# Shopify Storefront API (Headless sales channel)
# Domain only — no protocol prefix, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Private/delegate token — server-side only, never exposed to the client bundle
SHOPIFY_STORE_PRIVATE_TOKEN=

# Public token — reserved for any future client-side use case; unused by the
# current server-only data layer in src/lib/shopify
SHOPIFY_STORE_PUBLIC_TOKEN=

# Absolute site origin (no trailing slash), e.g. https://soothingsaunas.com
# in production or http://localhost:3000 in dev. Used to build Supabase
# email-link redirect URLs (invite/password-reset) outside a request context.
SITE_URL=

# Random, high-entropy secret mixed into every admin 2FA/OTP code hash
# (src/lib/auth/otp.ts) so a leaked code_hash can't be brute-forced offline.
# Generate with e.g. `openssl rand -hex 32`. Never reuse across environments.
ADMIN_OTP_PEPPER=
