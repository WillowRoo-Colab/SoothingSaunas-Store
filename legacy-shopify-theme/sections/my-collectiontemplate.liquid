{%  comment %}
  CUSTOM COLLECTIONS TEMPLATE
    w/ Product Filters
    w/ Thumbnail resizing
{% endcomment %}



<section id="my-collectiontemplate-{{ collection.id }}" class="my-collection">
<div class="collection-layout">

    <!-- ✅ SIDEBAR FILTERS -->
    <!--====================-->
<aside class="sidebar">

  <div class="sidebar-title">Product Filters</div>

  {% render 'my-separatorline' %}

  <form method="get" action="{{ collection.url }}" id="sidebarFilters">

    {% for filter in collection.filters %}
      <div class="filter-block">

        <div class="sidebar-filtertitle">
          {{ filter.label }}
        </div>

        {% if filter.type == 'list' %}

          {% for value in filter.values %}
            <label class="filter-option">
              <input
                type="checkbox"
                name="{{ filter.param_name }}"
                value="{{ value.value }}"
                {% if value.active %}checked{% endif %}
                {% if value.count == 0 and value.active == false %}disabled{% endif %}
              >

              <span>
                {%- comment -%}
                  🔽 CUSTOM SAUNA TYPE DISPLAY LABELS
                  Only applies to the sauna_type filter
                {%- endcomment -%}
                {% if filter.param_name contains 'sauna_type' and sauna_type_labels[value.value] %}
                  {{ sauna_type_labels[value.value] }}
                {% else %}
                  {{ value.label }}
                {% endif %}

                {% unless value.count == 0 %}
                  ({{ value.count }})
                {% endunless %}
              </span>
            </label>
          {% endfor %}

          {% render 'my-separatorline' %}

        {% elsif filter.type == 'price_range' %}

          <div class="price-range-wrapper">

            <!-- Price Min -->
            <div class="price-field labelmin">
              <label for="Filter-{{ filter.min_value.param_name }}">Min:</label>
              <div class="price-input-wrap">
                <input
                  id="Filter-{{ filter.min_value.param_name }}"
                  type="number"
                  name="{{ filter.min_value.param_name }}"
                  value="{{ filter.min_value.value }}"
                  min="{{ filter.range_min }}"
                  max="{{ filter.range_max }}"
                  placeholder="{{ filter.range_min }}">
              </div>
            </div>

            <!-- Price Max -->
            <div class="price-field labelmax">
              <label for="Filter-{{ filter.max_value.param_name }}">Max:</label>
              <div class="price-input-wrap">
                <input
                  id="Filter-{{ filter.max_value.param_name }}"
                  type="number"
                  name="{{ filter.max_value.param_name }}"
                  value="{{ filter.max_value.value }}"
                  min="{{ filter.range_min }}"
                  max="{{ filter.range_max }}"
                  placeholder="{{ filter.range_max }}">
              </div>
            </div>
          </div>

          {% render 'my-separatorline' %}

        {% endif %}
      </div>
    {% endfor %}

    <div class="apply-button">
      {% render 'my-goldbutton', label: 'Apply Filters', type: 'submit', size: 'small' %}
    </div>
    <div class="clearfilter-link">
          <a href="{{ collection.url }}" class="clear-filters-link">
            Clear filters
          </a>
    </div>
   </form>
</aside>


    <!-- ✅ MAIN CONTENT -->
    <!--=================-->
    <div class="collection-main-content">

      <!-- Collection Banner -->
      {% if collection.image %}
        <div class="ss-collection-banner">
          {% render 'my-roundedimageoverride',
            image: collection.image,
            alt: collection.title,
            width: 1800,
            radius: '36px',
            fit: 'cover' %}
        </div>
      {% endif %} 
  
      <!-- my-ScrollingBanner -->
      <div class="collection-scrollingbanner">
          {% render 'my-scrollingbanner', messages: collection.metafields.custom.collection_scrollingbanner.value %}
      </div>

      <!-- Sort Toolbar -->
      <div class="collection-toolbar">
        <div class="toolbar-left">
          <span class="product-count">{{ collection.products_count }} products</span>
        </div>

        <div class="toolbar-right">
          <div class="view-toggle">
            <button type="button" class="view-grid" aria-label="Grid view">☰</button>
            <button type="button" class="view-list" aria-label="List view">≡</button>
          </div>

          <div class="sort-by">
            <form method="get" class="sort-form">
              <label for="SortBy">Sort by: </label>
              <select name="sort_by" id="SortBy" class="sort-dropdown" onchange="this.form.submit()">
                {% for option in collection.sort_options %}
                  <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {% endfor %}
              </select>
            </form>
          </div>
        </div>
      </div>
      
      <!-- Product Grid -->
      <div class="ss-product-grid product-grid grid-view">
        {% for product in collection.products %}
          {% assign include_product = true %}

          {% assign min_price = request.params.min_price | default: 0 | times: 100 %}
          {% assign max_price = request.params.max_price | default: 20000 | times: 100 %}
          {% assign price = product.price %}

          {% if price < min_price or price > max_price %}
            {% assign include_product = false %}
          {% endif %}

          {% if request.params.in_stock and product.available == false %}
            {% assign include_product = false %}
          {% endif %}

          {% if request.params.sauna_type %}
            {% assign match_found = false %}
            {% for tag in request.params.sauna_type %}
              {% if product.tags contains tag %}
                {% assign match_found = true %}
              {% endif %}
            {% endfor %}
            {% if match_found == false %}
              {% assign include_product = false %}
            {% endif %}
          {% endif %}

          {% if include_product %}
            <div class="ss-product-card">
              <a href="{{ product.url }}" class="ss-product-link">
                {% if product.featured_image %}
                  {% render 'my-roundedimage',
                    image: product.featured_image,
                    alt: product.title,
                    radius: '14px',
                    fit: 'cover' %}
                {% endif %}
                <h3 class="ss-product-title">{{ product.title }}</h3>
                <p class="ss-product-price">{{ product.price | money }}</p>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- JS for view toggle -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const gridBtn = document.querySelector(".view-grid");
      const listBtn = document.querySelector(".view-list");
      const productGrid = document.querySelector(".product-grid");

      if (gridBtn && listBtn && productGrid) {
        gridBtn.addEventListener("click", function () {
          productGrid.classList.remove("list-view");
          productGrid.classList.add("grid-view");
        });

        listBtn.addEventListener("click", function () {
          productGrid.classList.remove("grid-view");
          productGrid.classList.add("list-view");
        });
      }
    });
  </script>

  
  <style>
  /* WHOLE PAGE STYLING */
  /* ================== */
    .collection-layout {
      display: flex;
      flex-direction: row;
      max-width: 1400px;
      margin: 0 auto;         /* centers the layout */
      padding: 0 0;        /* optional side padding */
      width: 100%;
      box-sizing: border-box;
      align-items: stretch;
    }

  /* SCROLLING BANNER STYLING */
  /* ======================== */
    .collection-scrollingbanner { 
      max-width: 100%;
      margin: 0 auto 12px;  /* center it + spacing below */
      box-sizing: border-box; 
      padding: 8px 0px;   /* top-bottom & sides */ 
    }
      
  /* SIDEBAR STYLING */
    .sidebar {
      flex: 0 1 25%;
      min-width: 250px;
      max-width: 25%;
      padding: 24px;
      background-color: #1a1a1a;
      box-shadow: inset 0 0 0 1px rgba(201,168,106,0.15);
      border-right: 1px solid rgba(201,168,106,0.25);
      border-left: 1px solid rgba(201,168,106,0.25);
      border-top: 1px solid rgba(201,168,106,0.25);
      border-bottom: 1px solid rgba(201,168,106,0.25);
      color: #c9a86a;
      font-family: 'Lato', sans-serif;
      box-sizing: border-box;
    }

    .sidebar-title { style: block; font-family: 'Cormorant Upright', serif; font-weight: 500; 
      font-size: 22px; font-style: italic; color: #c9a86a; text-align: center; }

    .sidebar-filtertitle { font-family: 'Cormorant Upright', serif; font-size: 20px; color: #c9a86a; margin-bottom: 10px; }

    .filter-option { display: flex; align-items: center; gap: 8px; padding-left: 8px; /* this is the key */    
      color: #faf3e0; font-family: 'Lato', sans-serif; font-size: 16px; }
 
    .sidebar .goldbutton.small { --goldbutton-font-size: 18px; }

    .ss-collection-banner { margin-bottom: 18px; }

    .collection-toolbar { display: flex; justify-content: space-between; align-items: center;
      border-top: 1px solid rgba(201,168,106,0.25); 
      border-bottom: 1px solid rgba(201,168,106,0.25);
      background-color: #111; padding: 12px 12px; 
      color: #c9a86a; font-family: 'Lato', sans-serif; font-size: 16px;
      margin-bottom: 24px; }

    /* FILTER OPTIONS */
    .price-range-wrapper { display: flex; flex-direction: row; gap: 12px;          /* vertical spacing between Min / Max */
       padding-left: 6px; } /* THIS is the visual alignment shift */

    .price-input-wrap { position: relative; }
    .price-input-wrap::before {
      content: "$";
      position: absolute;
      left: 8px;
      top: 50%;
      transform: translateY(-50%);
      color: #151515;
      font-size: 14px;
      pointer-events: none; } 
  
    .price-field.labelmin { font-size: 14px; color: #faf3e0; margin-bottom: 4px; }  
    .price-field.labelmax { font-size: 14px; color: #faf3e0; margin-bottom: 4px; }  

    
    /* PRICE FILTER INPUT – BASE STYLES */
    .price-field input[type="number"] {
      height: 28px;
      max-width: 90px;
      padding: 6px 8px;
      padding-left: 22px;
      font-size: 14px;
      border-radius: 10px;
      color: #151515;
      background: #faf3e0;
    }

    .apply-button { margin-top: 24px; text-align: center; font-size: 20px !important; }

    .clearfilter-link { color: #ece3cb; text-align: center; font-size: 14px; padding-top: 6px;}

    /* HORIZONTAL TOOLBAR STYLING */
    /* ========================== */

    /* Sort By Dropdown */
    .sort-by { display: flex; align-items: center; }
    .sort-dropdown option { color: #151515; background-color: #faf3e0; }
    .sort-dropdown:focus { outline: none; border-color: #c9a86a; box-shadow: 0 0 0 1px rgba(201,168,106,0.35); }
    
    /* Toggle Buttons */
    .view-toggle { display: flex; gap: 8px; }

    .view-toggle button {
      background: #1a1a1a;
      border: 0.75px solid rgba(201,168,106,0.50);
      border-color: #c9a86a;
      color: #c9a86a;
      font-size: 18px;
      cursor: pointer;
      margin-left: 8px;
      transition: color 0.2s ease;
      min-width: 32px; }

    .view-toggle button:hover { color: #f0d48c; }

    /* SPLIT: Right Side Toolbar */
    .toolbar-right {
      display: flex;
      align-items: center;
      gap: 30px;
      flex-wrap: nowrap; }  

    .sort-dropdown { color: #151515; font-size: 14px; }

   /* PRODUCT GRID STYLING */
   /* ==================== */
    .collection-main-content { flex: 1; padding: 24px; padding-top: 0px }

    .ss-product-grid.grid-view { display: grid; grid-template-columns: repeat(4, minmax(260px, 1fr)); gap: 32px; }
    .ss-product-grid.list-view { display: block; }
    .ss-product-card { background: #111; border-radius: 14px; padding: 12px; text-align: center;
      transition: transform 0.25s ease; display: flex; flex-direction: column; height: 100%; } /* critical */ 

    .ss-product-card a { display: flex; flex-direction: column; height: 100%; }
    .ss-product-card:hover { transform: scale(1.02); }
    .ss-product-card img { width: 100%; height: 260px; object-fit: cover; /* Set fixed height */
      object-position: center; border-radius: 14px; display: block; }

    .ss-product-title { font-family: 'Cormorant Upright', serif; font-size: 20px; font-style: italic; color: #c9a86a; margin-top: auto; font-weight: 400; }
    .ss-product-price { font-family: 'Lato', sans-serif; font-size: 16px; color: #ece3cb; }

  </style>
</section>

{% schema %}
{
  "name": "My Custom Collection",
  "settings": [],
  "presets": [
    {
      "name": "Custom Collection Template"
    }
  ]
}
{% endschema %}