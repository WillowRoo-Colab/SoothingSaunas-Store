{%- comment -%}
  CUSTOM ANIMATED GOLD BUTTON SNIPPET
  ====================================
  Reusable shimmering "Add to Order" button
  - Compatible with product forms, modals, banners, etc.
  - Pass a custom label via 'button_label' variable
  - Optional parameters:
      button_label: string (default "Add to Order")
      button_id: string (optional unique ID)
      button_class: string (additional classes)
  
  TO USE: 
      {% render 'my-goldbuybutton', button_label: 'Reserve Your Sauna' %}
 
    OR IN A PRODUCT FORM LIQUID:
      {%- form 'product', product -%}
      {% render 'my-goldbuybutton', button_label: 'Add to Order' %}
      {%- endform -%}

 {%-  endcomment -%}

{%- assign button_text = button_label | default: 'Add to Order' -%}
{%- assign button_id_attr = button_id | default: '' -%}
{%- assign button_class_attr = button_class | default: '' -%}

<button 
  id="{{ button_id_attr }}" 
  class="ss-cta {{ button_class_attr }}" 
  type="submit"
  data-button-role="add-to-order">
  <span class="ss-cta__label">{{ button_text }}</span>
  <span class="ss-cta__border"></span>
</button>

<style>
  /* Gold shimmer hover and base style - already optimized */
  .ss-cta {
    position: relative;
    display: inline-block;
    padding: 0.75em 2.5em;
    font-size: 18px;
    font-weight: 500;
    font-family: inherit;
    color: #C9A86A;
    background: transparent;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    overflow: hidden;
    transition: color 1.3s ease;
    z-index: 1;
  }

  .ss-cta__border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 3px solid #C9A86A;
    border-radius: 20px;
    z-index: -1;
    overflow: hidden;
  }

  .ss-cta__border::before {
    content: "";
    position: absolute;
    top: 0;
    left: -75%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      120deg,
      rgba(201,168,106,0) 0%,
      rgba(201,168,106,0.95) 80%,
      rgba(201,168,106,0) 100%
    );
    transform: skewX(-20deg);
  }

  .ss-cta:hover .ss-cta__border::before {
    animation: shimmerSweep 1.8s forwards;
  }

  @keyframes shimmerSweep {
    0% { left: -75%; }
    100% { left: 125%; }
  }

  .ss-cta:hover {
    color: #151515;
  }

  .ss-cta:hover .ss-cta__border {
    background: rgba(201,168,106,0.85);
  }

  .ss-cta:active .ss-cta__border {
    border-color: #B38E56;
  }

  /* LOADING STATE */
  .gold-button-loading {
    pointer-events: none;
    opacity: 0.7;
    position: relative;
  }

  .gold-button-loading .ss-cta__label {
    visibility: hidden;
  }

  .gold-button-loading::after {
  content: 'Processing...';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 16px;
  color: #C9A86A;
  background: linear-gradient(90deg, rgba(201,168,106,0.1), rgba(201,168,106,0.4), rgba(201,168,106,0.1));
  background-size: 200% 100%;
  animation: shimmerLoad 2s infinite linear;
  border-radius: 20px;
  z-index: 2;
}

  @keyframes shimmerLoad {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

