{% comment %}
SOOTHING SAUNAS — ADVANCED ZOOM MODAL

  TO RENDER, USE BOTH: 
    {% section 'my-productgallery' %}
    {% render 'my-zoommodal' %}

{% endcomment %}

<style>
  .ss-zoom-overlay{
    position:fixed; inset:0; background:rgba(0,0,0,.85);
    display:flex; align-items:center; justify-content:center;
    z-index:9999; animation:fadeInZoom .3s ease;
  }
  .ss-zoom-modal{
    position:relative; width:80vw; height:80vh; background:#111;
    border-radius:30px; overflow:hidden;
    box-shadow: 0 0 40px rgba(201,168,106,0.35), 0 0 80px rgba(201,168,106,0.2);
  }
  .ss-zoom-stage{
    position:relative; width:100%; height:100%;
    overflow:hidden; cursor:grab; touch-action:none;
  }
  .ss-zoom-stage.is-dragging{ cursor:grabbing; }

  /* Center via translate(-50%,-50%) and offset with CSS vars */
  .ss-zoomed-image{
    position:absolute; top:50%; left:50%;
    transform:translate(calc(-50% + var(--pos-x,0px)),
                        calc(-50% + var(--pos-y,0px)))
             scale(var(--zoom,1));
    transform-origin:0 0;
    max-width:none; max-height:none; width:auto; height:auto;
    user-select:none; pointer-events:none; -webkit-user-drag:none;
    will-change:transform; backface-visibility:hidden; image-rendering:auto;
    transition:transform .08s ease-out;
  }

  .ss-zoom-close{
    position:absolute; top:14px; right:20px; width:40px; height:40px;
    display:flex; align-items:center; justify-content:center;
    color:#C9A86A; font-size:20px; line-height:1;
    background:#151515; border:1.5px solid #C9A86A; border-radius:50%;
    cursor:pointer; z-index:10; box-shadow:0 0 10px rgba(201,168,106,.15);
    transition:opacity .15s ease, transform .15s ease, border-color .15s ease;
  }
  .ss-zoom-close:hover{ opacity:.85; transform:scale(1.05); border-color:#f0d48c; }

  @keyframes fadeInZoom{ from{opacity:0; transform:scale(.98)} to{opacity:1; transform:scale(1)} }

  /* ===== Main Media ===== */
#soothingsaunas-{{ section.id }} .ss-main-media {
  position: relative;
  width: 78%;
  margin: 0 auto;
  aspect-ratio: 4/3;
  background-color: #151515;
  border-radius: 14px;
  overflow: hidden;
  display: flex; justify-content: center; align-items: center;
  cursor: zoom-in;
}
#soothingsaunas-{{ section.id }} .ss-main-image {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  transition: opacity 0.3s ease, transform 0.25s ease;
}
#soothingsaunas-{{ section.id }} .ss-main-image:hover { transform: scale(1.015); }

/* ===== Thumbnails ===== */
#soothingsaunas-{{ section.id }} .ss-thumbs-wrapper {
  position: relative;
  width: 78%;
  margin: 12px auto 0;
}
#soothingsaunas-{{ section.id }} .ss-thumbs {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 8px;
  scroll-snap-type: x mandatory;
}
#soothingsaunas-{{ section.id }} .ss-thumb { flex: 0 0 calc(16.6% - 8px); border: none; background: none; cursor: pointer; }
#soothingsaunas-{{ section.id }} .ss-thumb-img {
  width: 100%; height: 70px; object-fit: cover; border-radius: 10px;
  transition: transform 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
}
#soothingsaunas-{{ section.id }} .ss-thumb-img:hover { transform: scale(1.05); opacity: 0.9; }
#soothingsaunas-{{ section.id }} .ss-thumb.active .ss-thumb-img {
  box-shadow: 0 0 0 3px #C9A86A, 0 0 8px rgba(201,168,106,0.4);
  transform: scale(1.05);
}

/* ===== Arrows ===== */
#soothingsaunas-{{ section.id }} .ss-scroll-arrow {
  position: absolute; top: 50%; transform: translateY(-50%);
  background: rgba(25,25,25,0.7); border: none; color: #c9a86a;
  font-size: 24px; padding: 8px; border-radius: 50%; cursor: pointer;
  transition: all 0.3s ease;
}
#soothingsaunas-{{ section.id }} .ss-scroll-arrow.left { left: -28px; }
#soothingsaunas-{{ section.id }} .ss-scroll-arrow.right { right: -28px; }
</style>

<!-- ========================================= -->
<!--   GALLERY + ZOOM SCRIPT (SELF-CONTAINED)  -->
<!-- ========================================= -->
<script>
document.addEventListener('DOMContentLoaded', function(){
  const galleries = document.querySelectorAll('.ss-gallery');
  galleries.forEach(gallery => {
    const thumbs = gallery.querySelectorAll('.ss-thumb');
    const mainMedia = gallery.querySelector('.ss-main-media');
    const leftArrow = gallery.querySelector('.ss-scroll-arrow.left');
    const rightArrow = gallery.querySelector('.ss-scroll-arrow.right');
    const thumbsWrap = gallery.querySelector('.ss-thumbs');

    thumbs.forEach(btn => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        const newSrc = img.src.split('?')[0] + '?width=2000';
        mainMedia.innerHTML = `<img src="${newSrc}" class="ss-main-image" style="cursor:zoom-in;">`;
        thumbs.forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    if (leftArrow && rightArrow && thumbsWrap){
      leftArrow.addEventListener('click', () => thumbsWrap.scrollBy({ left: -200, behavior:'smooth' }));
      rightArrow.addEventListener('click', () => thumbsWrap.scrollBy({ left: 200, behavior:'smooth' }));
    }
  });
});
</script> 


<script>
function openZoomModal(src) {
  const overlay = document.createElement('div');
  overlay.className = 'ss-zoom-overlay';

  const modal = document.createElement('div');
  modal.className = 'ss-zoom-modal';

  const closeBtn = document.createElement('span');
  closeBtn.className = 'ss-zoom-close';
  closeBtn.innerHTML = '&times;';

  const stage = document.createElement('div');
  stage.className = 'ss-zoom-stage';

  const img = document.createElement('img');
const base = src.split('?')[0];

// request Shopify’s *original* raster first, fall back to highest known width
img.src = `${base}?width=5760`;
img.srcset = `
  ${base}?width=800   800w,
  ${base}?width=1200 1200w,
  ${base}?width=1600 1600w,
  ${base}?width=2000 2000w,
  ${base}?width=2400 2400w,
  ${base}?width=3000 3000w,
  ${base}?width=3600 3600w,
  ${base}?width=4200 4200w,
  ${base}?width=4800 4800w,
  ${base}?width=5760 5760w
`;
img.sizes = '100vw';             // allow browser to pick largest needed
img.decoding = 'sync';
img.loading = 'eager';
img.fetchPriority = 'high';
  img.className = 'ss-zoomed-image';
  img.style.position = 'absolute';
  img.style.top = '50%';
  img.style.left = '50%';
  img.style.transformOrigin = 'center center';
  img.setAttribute('draggable', 'false');

  stage.appendChild(img);
  modal.appendChild(closeBtn);
  modal.appendChild(stage);
  overlay.appendChild(modal);
  document.body.appendChild(overlay);
  document.body.style.overflow = 'hidden';

  let zoom = 1, minZoom = 1, maxZoom = 4;
  let posX = 0, posY = 0;
  let dragging = false, startX = 0, startY = 0;
  let imgW = 0, imgH = 0;

  function apply() {
    cancelAnimationFrame(apply.f);
    apply.f = requestAnimationFrame(() => {
      img.style.transform =
        `translate(calc(-50% + ${posX}px), calc(-50% + ${posY}px)) scale(${zoom})`;
    });
  }

  // 🧩 FIT + CENTER
  img.onload = () => {
    const r = stage.getBoundingClientRect();
    imgW = img.naturalWidth;
    imgH = img.naturalHeight;
    const scale = Math.min(r.width / imgW, r.height / imgH);
    zoom = scale;
    minZoom = scale;
    posX = 0;
    posY = 0;
    apply();
  };

  // Zoom keeping point stable
  function stageToImageCoords(stageX, stageY) {
    const r = stage.getBoundingClientRect();
    const offsetX = (r.width / 2) + posX;
    const offsetY = (r.height / 2) + posY;
    return { x: (stageX - r.left - offsetX) / zoom, y: (stageY - r.top - offsetY) / zoom };
  }

  function zoomAt(stageX, stageY, newZoom) {
    const boundedZoom = Math.max(minZoom, Math.min(maxZoom, newZoom));
    const before = stageToImageCoords(stageX, stageY);
    zoom = boundedZoom;
    const after = stageToImageCoords(stageX, stageY);
    posX += (after.x - before.x) * zoom;
    posY += (after.y - before.y) * zoom;
    apply();
  }

  // Mouse wheel zoom
  stage.addEventListener('wheel', e => {
    e.preventDefault();
    const factor = Math.exp((-e.deltaY) * 0.0008);
    zoomAt(e.clientX, e.clientY, zoom * factor);
  }, { passive: false });

  // Drag to pan
  stage.addEventListener('mousedown', e => {
    dragging = true;
    startX = e.clientX - posX;
    startY = e.clientY - posY;
    stage.classList.add('is-dragging');
    img.style.transition = 'none';
  });
  window.addEventListener('mousemove', e => {
    if (!dragging) return;
    posX = e.clientX - startX;
    posY = e.clientY - startY;
    apply();
  });
  window.addEventListener('mouseup', () => {
    if (!dragging) return;
    dragging = false;
    img.style.transition = 'transform 0.1s ease-out';
    stage.classList.remove('is-dragging');
  });

  // Touch: pinch to zoom + pan
  let pinchStartZoom = 1, pinchStartDist = 0, pinchCx = 0, pinchCy = 0;
  stage.addEventListener('touchstart', e => {
    if (e.touches.length === 2) {
      const [a, b] = e.touches;
      pinchStartDist = Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
      pinchStartZoom = zoom;
      pinchCx = (a.clientX + b.clientX) / 2;
      pinchCy = (a.clientY + b.clientY) / 2;
    } else if (e.touches.length === 1) {
      dragging = true;
      startX = e.touches[0].clientX - posX;
      startY = e.touches[0].clientY - posY;
      img.style.transition = 'none';
    }
  }, { passive: true });

  stage.addEventListener('touchmove', e => {
    if (e.touches.length === 2) {
      e.preventDefault();
      const [a, b] = e.touches;
      const dist = Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
      const targetZoom = pinchStartZoom * (dist / pinchStartDist);
      zoomAt(pinchCx, pinchCy, targetZoom);
    } else if (e.touches.length === 1 && dragging) {
      posX = e.touches[0].clientX - startX;
      posY = e.touches[0].clientY - startY;
      apply();
    }
  }, { passive: false });

  window.addEventListener('touchend', () => {
    dragging = false;
    img.style.transition = 'transform 0.1s ease-out';
  }, { passive: true });

  // Close
  const close = () => {
    overlay.remove();
    document.body.style.overflow = '';
  };
  closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
}
// ✅ Register the function globally
window.SSZoomModal = { open: openZoomModal };
</script>