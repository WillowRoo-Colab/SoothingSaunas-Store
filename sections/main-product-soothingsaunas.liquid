{%- comment -%}
SOOTHING SAUNAS – CUSTOM PRODUCT TEMPLATE (FULL UPDATE)
- Gallery styling, popup overlay, and zoom fx moved to my-zoommodal.
- Adds separator lines above and below description
- Adds centered price & button row with 48px gap and side padding. 

SOOTHING SAUNAS – CUSTOM PRODUCT TEMPLATE (CLEAN DELUXE + PRICE ROW + ADVANCED ZOOM)
- High-res image swap (no blur)
- Click-to-zoom (1×→2×→3×→1×), drag-to-pan, pinch on mobile
- Natural cursor
- 65/35 layout
- Title (Cormorant Upright), Vendor (Lato), Description (Lato)
- Adjustable separator & price styling
- “Add to Order” shimmering gold button (snippet)
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section id="soothingsaunas-{{ section.id }}" class="soothingsaunas-product">
  <div class="ss-container">
    <div class="ss-product-grid">
  
<!-- ========================================= -->
<!--         PRODUCT GALLERY SECTION           -->
<!-- ========================================= -->
<!-- === Left: Gallery === -->
<div class="ss-gallery">
  {% if product.media.size > 0 %}
    <div class="ss-main-media">
      {% assign featured = product.media.first %}
      {% if featured %}
        {{ featured | image_url: width: 1600 | image_tag: class: 'ss-main-image', loading: 'eager', widths: '600,1000,1400,1600,2000' }}
      {% endif %}
    </div>

    {% if product.media.size > 1 %}
      <div class="ss-thumbs-wrapper">
        <button class="ss-scroll-arrow left" aria-label="Scroll left">&#10094;</button>
        <div class="ss-thumbs">
          {% for media in product.media %}
            <button type="button" class="ss-thumb" data-media-id="{{ media.id }}">
              {{ media | image_url: width: 200 | image_tag: class: 'ss-thumb-img', loading: 'lazy', widths: '100,150,200' }}
            </button>
          {% endfor %}
        </div>
        <button class="ss-scroll-arrow right" aria-label="Scroll right">&#10095;</button>
      </div>
    {% endif %}
  {% endif %}
</div>
   {% render 'my-zoommodal' %}


<script>
  /* Wrap price + button row */
  (function makePurchaseRow(){
    const priceEl = root.querySelector('.ss-price');
    const buyEl = root.querySelector('.ss-buy');
      if (!priceEl || !buyEl) return;
      if (buyEl.parentElement && buyEl.parentElement.classList.contains('ss-purchase-row')) return;
    const row = document.createElement('div');
    row.className = 'ss-purchase-row';
    row.style.display = 'flex';
    row.style.alignItems = 'right';
    row.style.justifyContent = 'space-between';
    row.style.gap = '0';
    row.style.marginTop = '12px';
    priceEl.parentElement.insertBefore(row, priceEl);
    row.appendChild(priceEl);
    row.appendChild(buyEl);
  })();

  /* Zoom modal binder */
  function enableZoomModal(imgEl) {
    if (!imgEl) return;
    imgEl.onclick = () => openZoomModal(imgEl.src);
  }

  /* Initial binding */
  setTimeout(() => { if (mainImg) enableZoomModal(mainImg); }, 50);
});
</script>

      <!-- === Info (Right Column) === -->
      <div class="ss-info">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% case block.type %}

              {% when 'vendor' %}
                <div class="ss-vendor" {{ block.shopify_attributes }}>
                  <span class="vendor-prefix">by </span>
                  <a href="{{ product.vendor | url_for_vendor }}" class="custom-sauna-vendor">{{ product.vendor }}</a>
                </div>

              {% when 'title' %}
                {%- assign heading_tag = block.settings.heading_tag | default: 'h1' -%}
                <{{ heading_tag }} class="product-title custom-sauna-title" {{ block.shopify_attributes }}>
                  {{ product.title }}
                </{{ heading_tag }}>
                {% if section.settings.show_collection_badge and product.collections.size > 0 %}
                  <p class="ss-collection-line"><em>{{ section.settings.collection_line_prefix | default: 'from our collection' }}</em></p>
                {% endif %}

              {% when 'price' %}
                <div class="ss-price" {{ block.shopify_attributes }}>
                  <span class="ss-price-current" style="
                    font-size: {{ section.settings.price_font_size }};
                    color: {{ section.settings.price_color }};
                    margin-left: {{ section.settings.price_indent }}px;"
                    data-base-price="{{ current_variant.price }}">
                    {{ current_variant.price | money }}
                  </span>
                  {% if current_variant.compare_at_price > current_variant.price %}
                    <span class="ss-price-compare">{{ current_variant.compare_at_price | money }}</span>
                  {% endif %}
                </div>

              {% when 'description' %}
                {% if product.description != blank %}
                  <div class="ss-description" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {% endif %}

                {% if section.settings.second_description_line != blank %}
                <p class="ss-description-sub">{{ section.settings.second_description_line }}</p>
                {% endif %} 
              
<!-- METAFIELD LINES -->
                {% if product.metafields.custom.personcap %}
                <p class="ss-capacity"><b>Seating Capacity</b>:  up to <b>{{ product.metafields.custom.personcap }}</b> people</p>
                {% endif %}

                {% if product.metafields.custom.heat_style %}
                <p class="ss-heatsource"><b>Heating Style</b>:  {{ product.metafields.custom.heat_style }}</p>
                {% endif %}

                {% if product.metafields.custom.productspecs %}
                <a href="{{ product.metafields.custom.productspecs | file_url }}" target="_blank" class="ss-productspecs"> <b><u>View Product Specifications</b></u> </a>
                {% endif %}
                
                {% if product.metafields.custom.eheater_options %}
                  <div class="ss-eheater-options">
                      <b><u>Available Heater Options</u></b>:
                      <ul>
                        {% for option in product.metafields.custom.eheater_options %}
                          <li>{{ option }}</li>
                        {% endfor %}
                      </ul>
                  </div>
                {% endif %}
<!-- END METAFIELD LINES -->

              {% when 'separator' %}
                {% render 'my-separatorline' %}

              {% when 'buy_buttons' %}
                {% render 'my-productaddons' %} <!-- Add-On Checkboxes -->
                <div class="ss-buy" {{ block.shopify_attributes }}>
                  {%- assign form_id = 'ss-form-' | append: section.id -%}
                  {%- form 'product', product, id: form_id, class: 'ss-product-form', novalidate: 'novalidate' -%}
                     <input type="hidden" name="id" value="{{ current_variant.id }}">
                    {% render 'my-goldbuybutton', button_label: 'Add to Order' %}
                  {%- endform -%}
                </div>

            {% endcase %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>

  <style>

  /*  ==  MOBILE SCREEN ADJUSTMENTS  ==  */
  /*  =================================  */
  <style>
  @media screen and (max-width: 768px) {
    .mysoothing-wrapper {
      flex-direction: column;
    }

    .mysoothing-info, .mysoothing-gallery {
      width: 100%;
      text-align: center;
    }

    .product-title,
    .collection-line,
    .vendor-name,
    .product-price {
      text-align: center !important;
      margin-left: 0 !important;
    }

    /* Show fewer thumbs (approx. 3 per row) */
    .ss-thumb {
      flex: 0 0 calc(33.33% - 8px) !important;
    }

    /* Move banner above gallery */
    .mysoothing-banner-mobile {
      display: block;
    }

    .mysoothing-banner-desktop {
      display: none;
    }

    .buy-button-wrapper {
      text-align: center;
      margin: 1.5rem auto 0;
    }
  }

  @media screen and (min-width: 769px) {
    .mysoothing-banner-mobile {
      display: none;
    }

    .mysoothing-banner-desktop {
      display: block;
    }
  }
</style>

/* ===== Layout ===== */
#soothingsaunas-{{ section.id }} .ss-container {
  max-width: 1600px;
  margin: 0 auto;
  padding: clamp(60px, 8vw, 120px) clamp(24px, 5vw, 80px);
  box-sizing: border-box;
}
#soothingsaunas-{{ section.id }} .ss-product-grid {
  display: grid;
  grid-template-columns: 65% 35%;
  column-gap: clamp(12px, 1.25vw, 24px);
  align-items: start;
}



/* ===== Typography ===== */
.custom-sauna-title {
  font-family: 'Cormorant Upright', serif; color: #ece3cb; font-weight: 600;
  font-size: clamp(24px, 4vw + 1rem, 30px); margin-top: 8px; letter-spacing: 0.3px;
}
/* .vendor-prefix { font-family: 'Lato', sans-serif; color: #e8e1c4; opacity: .85; font-size: 14px; margin-left: 64px; } */
.custom-sauna-vendor { font-family: 'Lato', sans-serif; color: #ece3cb; font-size: 16px; font-weight: 500; }
.ss-collection-line { font-family: 'Cormorant Upright', serif; font-size: 22px; color: #c9a86a; font-style: italic; margin-left: 24px; }
.ss-description { font-family: 'Lato', sans-serif; color: #e8e1c4; font-size: 16px; line-height: 1.55; margin: 20px 0 36px; }
.ss-description-sub { font-family: 'Lato', sans-serif; color: #e0dbc5; font-size: 14px; /* slightly smaller than main */ line-height: 1.45; margin-top: -8px; margin-bottom: 32px; opacity: 0.85;
}
/* === Product Capacity Metafield Styling === */
.ss-productspecs {
  font-family: 'Lato', sans-serif;      /* matches your theme’s body font */
  font-size: 16px;                      /* adjust to desired size */
  align: centered;
  color: #e8e1c4;                       /* your off-white gold tone */
  margin-top: 16px;                     /* spacing above the line */
  letter-spacing: 0.3px;                /* soft spacing for readability */
  opacity: 0.9;                         /* keeps it slightly muted */
}
.ss-capacity {
  font-family: 'Lato', sans-serif;      /* matches your theme’s body font */
  font-size: 16px;                      /* adjust to desired size */
  color: #e8e1c4;                       /* your off-white gold tone */
  margin-top: 12px;                     /* spacing above the line */
  letter-spacing: 0.3px;                /* soft spacing for readability */
  opacity: 0.9;                         /* keeps it slightly muted */
}
  .ss-heatsource {
  font-family: 'Lato', sans-serif;      /* matches your theme’s body font */
  font-size: 16px;                      /* adjust to desired size */
  color: #e8e1c4;                     /* your off-white gold tone */
  margin-top: 8px;                      /*spacing above the line */
  letter-spacing: 0.3px;                /* soft spacing for readability */
  opacity: 0.9;                         /* keeps it slightly muted */ 
}  
  .ss-productspecs {
  font-family: 'Lato', sans-serif;      /* matches your theme’s body font */
  font-size: 16px;                      /* adjust to desired size */
  text-align: centered;
  color: #e8e1c4;                       /* your off-white gold tone */
  margin-top: 16px;                     /* spacing above the line */
  letter-spacing: 0.3px;                /* soft spacing for readability */
  opacity: 0.9;                         /* keeps it slightly muted */
}
/* Optional: shrink slightly on mobile for balance */
@media (max-width: 768px) {
  .ss-capacity {
    font-size: 15px;
    margin-top: 8px;
  }
}
/* ===== MOBILE Responsive Indentation Logic ===== */
  /* ===== Desktop Vendor Alignment ===== */
@media (min-width: 769px) {
  #soothingsaunas-{{ section.id }} .ss-vendor {
    margin-left: 64px;           /* keep your elegant tiered indent */
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  #soothingsaunas-{{ section.id }} .vendor-prefix {
    margin: 0;                   /* no extra spacing inside */
  }
}
/* ===== Mobile Vendor Centering ===== */
@media (max-width: 768px) {
  #soothingsaunas-{{ section.id }} .ss-vendor {
    margin-left: 0;              /* remove indent */
    justify-content: center;     /* fully centered */
    text-align: center;
  }
}
  #soothingsaunas-{{ section.id }} .ss-vendor {
    display: inline-flex;
    align-items: baseline;  /* aligns text bottoms properly */
    justify-content: center;
    gap: 4px;
}
}
/* ===== END Responsive Indentation Logic ===== */

/* ===== Separator ===== */
.ss-separator-block {
  border-bottom: solid {{ section.settings.separator_thickness | default: 1 }}px {{ section.settings.separator_color | default: '#a08119' }};
  margin: 20px 0; opacity: 0.3;
}

/* ===== Modal (legacy selectors retained for your theme) ===== */
#soothingsaunas-{{ section.id }} .ss-image-modal {
  display: none; position: fixed; z-index: 9999; inset: 0;
  background: rgba(27, 21, 15, 0.95);
}
#soothingsaunas-{{ section.id }} .ss-modal-content {
  display: block; margin: 60px auto; max-width: 90%; max-height: 85vh;
  border-radius: 10px; transition: transform 0.3s ease;
  cursor: grab;
}
#soothingsaunas-{{ section.id }} .ss-modal-close {
  position: absolute; top: 20px; right: 35px; color: #c9a86a;
  font-size: 36px; cursor: pointer; z-index: 10001;
}
@keyframes zoomIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
@media (max-width: 1000px) {
  .ss-product-grid { grid-template-columns: 1fr; }
  .ss-main-media, .ss-thumbs-wrapper { width: 100%; }
}
/* === START of MOBILE 1-COLUMN REORDER === */
@media (max-width: 768px) {
  #soothingsaunas-{{ section.id }} .ss-product-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Stack main image + thumbs full width */
  #soothingsaunas-{{ section.id }} .ss-main-media,
  #soothingsaunas-{{ section.id }} .ss-thumbs-wrapper {
    width: 100%;
    margin: 12px 0;
  }

  /* Reduce side padding for better fit */
  #soothingsaunas-{{ section.id }} .ss-container {
    padding: 24px 16px;
  }

  /* Adjust title + text sizes for mobile readability */
  #soothingsaunas-{{ section.id }} .custom-sauna-title {
    font-size: 26px;
    margin-bottom: 6px;
  }
  #soothingsaunas-{{ section.id }} .ss-collection-line {
    font-size: 18px;
    margin: 0 auto 8px;
  }
  #soothingsaunas-{{ section.id }} .custom-sauna-vendor {
    display: block;
    margin: 0 auto 16px;
  }

  /* Description spacing */
  #soothingsaunas-{{ section.id }} .ss-description {
    margin: 16px 0;
  }

  /* Separator line adjustment */
  #soothingsaunas-{{ section.id }} .ss-separator-block {
    width: 60%;
    margin: 18px auto;
  }

  /* Ensure add-on checkboxes + price + button flow naturally */
  #soothingsaunas-{{ section.id }} .ss-buy,
  #soothingsaunas-{{ section.id }} .ss-price {
    width: 100%;
    margin-top: 16px;
  }
  #soothingsaunas-{{ section.id }} .ss-buy button {
    width: 100%;
    margin-top: 12px;
  }
}
/* === END of MOBILE 1-COLUMN REORDER === */
.ss-eheater-options {
  font-family: 'Lato', sans-serif;
  color: #e8e1c4;
  font-size: 16px;
  margin-top: 20px;
  line-height: 1.5;
}

.ss-eheater-options b {
  color: #c9a86a;
}

.ss-eheater-options ul {
  margin: 8px 0 0 20px;
  padding: 0;
  list-style-type: square;
}

.ss-eheater-options li {
  margin: 4px 0;
}
  </style>
</section>

{% schema %}
{
 /* "name": "OMIT Soothing Saunas Product",  */
  "settings": [
    { "type": "checkbox", "id": "show_collection_badge", "label": "Show collection line", "default": true },
    { "type": "text", "id": "collection_line_prefix", "label": "Collection line prefix", "default": "from the" },
    { "type": "color", "id": "separator_color", "label": "Separator color", "default": "#a08119" },
    { "type": "range", "id": "separator_thickness", "label": "Separator thickness", "min": 1, "max": 8, "step": 1, "default": 2 },
    { "type": "text", "id": "price_font_size", "label": "Price font size", "default": "22px" },
    { "type": "color", "id": "price_color", "label": "Price color", "default": "#ece3cb" },
    { "type": "range", "id": "price_indent", "label": "Price indent (px)", "min": 0, "max": 50, "step": 2, "default": 0 },
    { "type": "text", "id": "second_description_line", "label": "Optional second description line" }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor" },
    { "type": "title", "name": "Title" },
    { "type": "price", "name": "Price" },
    { "type": "description", "name": "Description" },
    { "type": "separator", "name": "Separator Line" },
    { "type": "buy_buttons", "name": "Buy Buttons" }
  ],
  "presets": [
    {
      "name": "OMIT Soothing Saunas Product",
      "blocks": [
        { "type": "title" },
        { "type": "vendor" },
        { "type": "separator" },
        { "type": "description" },
        { "type": "separator" },
        { "type": "price" },
        { "type": "buy_buttons" }
      ]
    }
  ]
}
{% endschema %}
