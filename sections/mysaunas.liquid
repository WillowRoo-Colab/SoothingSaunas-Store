<script>
/* ------------------------------------------------------ */
/*   SOOTHING SAUNAS — MASTER JAVASCRIPT BUNDLE (FINAL)   */
/*   Handles variants, add-ons, price updates, gallery    */
/*   interactions, scrolling banner, and cart bundling.   */
/* ------------------------------------------------------ */

document.addEventListener("DOMContentLoaded", () => {

  /* ===================================================== */
  /*                     1. PRICE ENGINE                   */
  /* ===================================================== */
  function updatePriceDisplay() {
    const priceEl = document.querySelector(".ss-price-main");
    if (!priceEl) return;

    const basePriceRaw = parseFloat(priceEl.dataset.basePrice || 0);

    let addonsTotal = 0;

    document.querySelectorAll(".ss-addon-checkbox:checked").forEach(cb => {
      const price = parseFloat(cb.dataset.price || 0);
      const discount = parseFloat(cb.dataset.discount || 0);
      const final = price - (price * (discount / 100));
      addonsTotal += final;
    });

    const newTotal = basePriceRaw + addonsTotal;

    const formatted = Shopify.formatMoney(newTotal * 100);
    priceEl.innerHTML = formatted;
  }

  /* ===================================================== */
  /*                 2. VARIANT SELECTION                  */
  /* ===================================================== */
  function selectVariant(optionIndex, value) {
    const variants = window.productVariants || [];
    if (!variants.length) return null;

    const found = variants.find(v => v.options[optionIndex] === value);
    if (found) {
      const variantId = found.id;
      const url = new URL(window.location.href);
      url.searchParams.set("variant", variantId);
      window.history.replaceState(null, "", url.toString());

      document.querySelector("input[name='id']").value = variantId;

      const priceEl = document.querySelector(".ss-price-main");
      if (priceEl) {
        priceEl.dataset.basePrice = found.price / 100;
      }
      updatePriceDisplay();
    }
  }

  /* ===================================================== */
  /*          3. BIND VARIANT BUTTON/DROPDOWN EVENTS       */
  /* ===================================================== */
  document.querySelectorAll("[data-variant-option]").forEach(container => {
    const optionIndex = parseInt(container.dataset.optionIndex);

    /* BUTTON MODE */
    container.querySelectorAll("[data-value]").forEach(btn => {
      btn.addEventListener("click", () => {
        container.querySelectorAll("[data-value]").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        selectVariant(optionIndex, btn.dataset.value);
      });
    });

    /* DROPDOWN MODE */
    const select = container.querySelector("select");
    if (select) {
      select.addEventListener("change", () => {
        selectVariant(optionIndex, select.value);
      });
    }
  });

  /* ===================================================== */
  /*                  4. ADD-ONS ENGINE                    */
  /* ===================================================== */
  document.addEventListener("DOMContentLoaded", function () {

  /* ---------------------------------------------------------
     ADD-ON ENGINE — GLOBAL HOOKS
     --------------------------------------------------------- */
  const addonCheckboxes = document.querySelectorAll(".addon-checkbox");
  const mainPriceEl = document.querySelector(".ss-price-final");
  const originalPrice = parseFloat(
    mainPriceEl?.dataset?.basePrice || mainPriceEl?.textContent.replace(/[^0-9.]/g, "") || 0
  );

  /* Track totals */
  function calculateAddonTotal() {
    let total = 0;

    addonCheckboxes.forEach(cb => {
      if (cb.checked) {
        const price = parseFloat(cb.dataset.addonPrice || "0");
        total += price;
      }
    });

    return total;
  }

  /* Update displayed price */
  function updateDisplayedPrice() {
    if (!mainPriceEl) return;

    const addons = calculateAddonTotal();
    const newTotal = originalPrice + addons;

    mainPriceEl.textContent = Shopify.formatMoney(newTotal * 100);
  }

  /* Watch for changes */
  addonCheckboxes.forEach(cb => {
    cb.addEventListener("change", updateDisplayedPrice);
  });


  /* ---------------------------------------------------------
     ADD-ONS → ADD TO CART BUNDLE LOGIC
     --------------------------------------------------------- */
  const addToCartButton = document.querySelector("button[type='submit'][name='add']");
  if (!addToCartButton) return;

  addToCartButton.addEventListener("click", function (event) {
    event.preventDefault();
      const mainVariantId = document.querySelector("input[name='id']")?.value;
  if (!mainVariantId || typeof addBundleToCart !== "function") return;

  await addBundleToCart(mainVariantId);
  window.location.href = '/cart';
});

    const form = addToCartButton.closest("form");
    if (!form) return;

    const formData = new FormData(form);

    let mainVariantID = formData.get("id"); // Main product variant
    let itemsToAdd = [];

    /* 1) Add MAIN PRODUCT */
    itemsToAdd.push({
      id: mainVariantID,
      quantity: 1
    });

    /* 2) Add selected add-ons */
    addonCheckboxes.forEach(cb => {
      if (cb.checked) {
        itemsToAdd.push({
          id: cb.dataset.addonVariant,
          quantity: 1
        });
      }
    });

    /* 3) Perform AJAX add */
    fetch(window.Shopify.routes.root + "cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ items: itemsToAdd })
    })
      .then(response => response.json())
      .then(data => {
        /* Redirect to cart, drawer, or refresh based on Prestige settings */
        if (window.CartDrawer) {
          window.CartDrawer.open();
        } else {
          window.location.href = "/cart";
        }
      })
      .catch(err => console.error("Add-on bundle error:", err));
  });

});

  /* ===================================================== */
  /*        5. ADD TO CART (PRIMARY + ADD-ONS) BUNDLE      */
  /* ===================================================== */
  const atcBtn = document.querySelector(".ss-addtocart-btn");
  if (atcBtn) {
    atcBtn.addEventListener("click", async (e) => {
      e.preventDefault();

      const mainVariantId = document.querySelector("input[name='id']").value;

      const itemsToAdd = [
        {
          id: mainVariantId,
          quantity: 1
        }
      ];

      document.querySelectorAll(".ss-addon-checkbox:checked").forEach(cb => {
        const vid = cb.dataset.variantId;
        if (vid) {
          itemsToAdd.push({
            id: vid,
            quantity: 1
          });
        }
      });

      /* Shopify AJAX Cart API */
      await fetch("/cart/add.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ items: itemsToAdd })
      });

      window.location.href = "/cart";
    });
  }

  /* ===================================================== */
  /*                 6. SCROLLING BANNER                   */
  /* ===================================================== */
  const banner = document.querySelector(".ss-scroll-banner");
  if (banner) {
    const messages = banner.dataset.messages.split("\n").map(t => t.trim()).filter(Boolean);
    const speed = parseInt(banner.dataset.speed || 18);

    function nextMessage() {
      const msg = messages[Math.floor(Math.random() * messages.length)];
      banner.querySelector(".ss-scroll-text").textContent = msg;
    }

    nextMessage();

    setInterval(() => {
      nextMessage();
    }, speed * 1000);
  }

  /* ===================================================== */
  /*            7. PRODUCT GALLERY INTERACTION             */
  /* ===================================================== */
  const thumbs = document.querySelectorAll(".ss-thumb");
  const mainImg = document.querySelector(".ss-main-image");

  if (thumbs && mainImg) {
    thumbs.forEach(btn => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        const newSrc = img.src.split('?')[0] + '?width=2000';

    // Replace the main image
    mainMedia.innerHTML = `<img src="${newSrc}" class="ss-main-image" style="cursor:zoom-in;">`;

   setTimeout(() => {
    const initialImg = document.querySelector(".ss-main-image");
    enableZoomModal(initialImg);
    }, 50);

  /* ===================================================== */
  /*                     8. ZOOM MODAL                     */
  /* ===================================================== */
  if (window.SSZoomModal && typeof window.SSZoomModal.init === "function") {
    window.SSZoomModal.init();
  }

});
function addBundleToCart(mainVariantId, addonSelectors = ".ss-addon-checkbox:checked") {
  const addons = Array.from(document.querySelectorAll(addonSelectors)).map(cb => ({
    id: cb.dataset.variantId,
    quantity: 1
  }));

  const items = [{ id: mainVariantId, quantity: 1 }, ...addons];

  return fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ items })
  });
}
</script>

