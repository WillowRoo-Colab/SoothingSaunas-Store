{% if section.blocks.size > 0 %}
  {% for block in section.blocks %}
    {% case block.type %}

    <!-- ========================================= -->
    <!--             VARIANT OPTIONS BLOCK         -->
    <!-- ========================================= -->
    {% when 'variant_display' %}
      {% assign opt_index = block.settings.option_index | plus: 0 %}
      {% assign option_name = product.options[opt_index] %}

      <div class="ss-variant-block" {{ block.shopify_attributes }}>
        <label class="ss-variant-label">{{ option_name }}</label>

        {% if block.settings.display_mode == 'dropdown' %}
          <select class="ss-variant-select">
            {% for variant in product.variants %}
              <option 
                value="{{ variant.id }}"
                {% if variant.selected %}selected{% endif %}
                data-var-price="{{ variant.price | divided_by: 100 }}"
              >
                {{ variant.option1 }}{% if variant.option2 %} / {{ variant.option2 }}{% endif %}
                {% if variant.option3 %} / {{ variant.option3 }}{% endif %}
              </option>
            {% endfor %}
          </select>

        {% elsif block.settings.display_mode == 'buttons' %}
          <div class="ss-variant-buttons">
            {% for variant in product.variants %}
              <button 
                class="ss-variant-btn {% if variant == product.selected_or_first_available_variant %}active{% endif %}"
                data-id="{{ variant.id }}"
                data-var-price="{{ variant.price | divided_by: 100 }}"
              >
                {{ variant.options[opt_index] }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

<!-- ========================================= -->
<!--               ADD-ONS BLOCK               -->
<!-- ========================================= -->
    {% when 'addon_block' %}
      <div class="ss-addons" {{ block.shopify_attributes }}>
  
        {% if block.settings.addon_title != blank %}
          <h3 class="ss-addon-title">{{ block.settings.addon_title }}</h3>
        {% endif %}

      {% assign addon_list = product.metafields.custom.addons %}

      {% if addon_list and addon_list.value.size > 0 %}
        {% for addon in addon_list.value %}
          {% assign price = addon.price | default: 0 %}
          {% assign discount = addon.discount | default: 0 %}
          {% assign variant_id = addon.variant_id | default: blank %}

      {# Compute discounted price safely #}
          {% assign discount_amount = price | times: discount | divided_by: 100 %}
          {% assign final_price = price | minus: discount_amount %}

        <label class="ss-addon-option">
          <input type="checkbox"
               class="ss-addon-checkbox"
               data-price="{{ price }}"
               data-discount="{{ discount }}"
               data-variant-id="{{ variant_id }}">
        
          <span class="ss-addon-label">{{ addon.label }}</span>

      {% if block.settings.show_discounts and discount > 0 %}
         <span class="ss-addon-price">
           <span class="ss-addon-original">{{ price | money }}</span>
           <span class="ss-addon-discounted">{{ final_price | money }}</span>
         </span>
        {% else %}
         <span class="ss-addon-price">{{ price | money }}</span>
        {% endif %}
      </label>

        {% endfor %}
        {% else %}
    <p class="ss-addon-empty">No add-ons available for this product.</p>
  {% endif %}

</div>

    {% endcase %}
  {% endfor %}
{% endif %}
